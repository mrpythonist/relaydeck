# Copy to .env for local development. Never commit a real .env.
# RelayDeck reads RELAYDECK_* variables; see README for the full list.
RELAYDECK_LISTEN_ADDR=:8080
RELAYDECK_DATA_DIR=./data
# RELAYDECK_API_KEY=change-me-to-a-long-random-string
RELAYDECK_WORKERS=4
RELAYDECK_MAX_PAYLOAD_BYTES=1048576
# RELAYDECK_ALLOW_PRIVATE_DESTINATIONS=true   # local dev only; never in production
# RELAYDECK_TRUSTED_INTERNAL_DESTINATIONS=
RELAYDECK_RETENTION_DAYS=30
# Hosted SaaS mode (Phase 1). Default false = single-tenant self-hosted.
# RELAYDECK_HOSTED=true
# Stripe billing (hosted only). Leave empty until Stripe is set up;
# see docs/HOSTED.md for the dashboard steps. Never commit real keys.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_SUCCESS_URL=https://example.com/dashboard?billing=success
# STRIPE_CANCEL_URL=https://example.com/pricing?billing=cancelled
