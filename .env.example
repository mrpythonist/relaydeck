# Copy to .env for local development. Never commit a real .env.
# RelayDeck reads RELAYDECK_* variables; see README for the full list.
RELAYDECK_LISTEN_ADDR=:8080
RELAYDECK_DATA_DIR=./data
# RELAYDECK_API_KEY=change-me-to-a-long-random-string
RELAYDECK_WORKERS=4
RELAYDECK_MAX_PAYLOAD_BYTES=1048576
# RELAYDECK_ALLOW_PRIVATE_DESTINATIONS=true   # local dev only; never in production
# RELAYDECK_TRUSTED_INTERNAL_DESTINATIONS=
RELAYDECK_RETENTION_DAYS=30
